---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | TopBesticles</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; color: #111; background: #f9fafb; line-height: 1.6; }
      a { color: #4f46e5; }
      header { background: #fff; border-bottom: 1px solid #e5e7eb; padding: 0 1.5rem; display: flex; align-items: center; justify-content: space-between; height: 60px; }
      header .brand { font-weight: 900; font-size: 1.3rem; color: #4f46e5; text-decoration: none; }
      nav a { margin-left: 1.5rem; font-size: 0.875rem; text-decoration: none; color: #374151; }
      nav a:hover { color: #4f46e5; }
      main { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      footer { border-top: 1px solid #e5e7eb; text-align: center; padding: 1.5rem; font-size: 0.8rem; color: #6b7280; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">TopBesticles</a>
      <nav>
        <a href="/">Home</a>
        <a href="/keystatic">CMS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>&copy; 2026 TopBesticles</footer>
  </body>
</html>
