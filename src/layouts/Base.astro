---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/settings';

interface Props {
  title: string;
  description?: string;
  metaTitle?: string;
  metaDescription?: string;
}

const settings = await getSettings();

const {
  title,
  description,
  metaTitle,
  metaDescription,
} = Astro.props;

// SEO: prefer the explicit metaTitle/metaDescription; otherwise fall back to
// the page title (with brand suffix) and the description — and finally to
// the Settings singleton's default meta description.
const pageTitle = metaTitle ?? `${title} | ${settings.siteName}`;
const pageDescription = metaDescription ?? description ?? settings.metaDescription;

// OG image URL mirrors the page's own path under /og/<path>.png (see
// src/pages/og/[...slug].png.ts, which generates one PNG per real page at
// build time). Keeping this derived from the URL — rather than a prop each
// page has to pass — means every page automatically gets a matching image
// as long as that endpoint's getStaticPaths knows about it.
const trimmedPath = Astro.url.pathname.replace(/^\/|\/$/g, '');
const ogSlug = trimmedPath === '' ? 'home' : trimmedPath;
const ogImageUrl = new URL(`/og/${ogSlug}.png`, Astro.site).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/logo/icon-512x512.png" />

    <!-- Open Graph / Twitter card — image generated at build time, see
         src/pages/og/[...slug].png.ts -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Analytics (GA4) — loads on every page via the Base layout. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CMJQVQYJ7G"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CMJQVQYJ7G');
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot name="before-header" />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
/* ── Design tokens ─────────────────────────────────────── */
:root {
  --bg:#F6F7FB;--bg-2:#EEF0F8;--card:#FFFFFF;--ink:#13151B;--ink-2:#565C6B;--ink-3:#9AA0B2;--line:#E6E8F2;
  --v1:#6D4DFB;--v2:#8B5CF6;--cyan:#22D3EE;--accent:#6D4DFB;--accent-2:#5A3EF0;--soft:#ECEAFE;
  --grad:linear-gradient(135deg,#6D4DFB 0%,#8B5CF6 55%,#22D3EE 130%);
  --fresh:#0E9AA5;--fresh-bg:#E2F6F8;
  --sh:0 1px 2px rgba(20,20,40,.05),0 16px 36px -20px rgba(40,30,90,.28);
  --sh-h:0 2px 4px rgba(20,20,40,.06),0 30px 56px -22px rgba(60,40,140,.4);
  --maxw:1140px;
}

/* ── Reset ─────────────────────────────────────────────── */
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Poppins',system-ui,sans-serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;font-size:17px;line-height:1.65;}
a{color:inherit;text-decoration:none;}
img{display:block;max-width:100%;}

/* ── Layout utils ──────────────────────────────────────── */
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;}

/* ── Buttons ───────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-family:inherit;border:0;border-radius:999px;cursor:pointer;transition:transform .15s,box-shadow .2s,filter .2s;}
/* text-shadow keeps white text readable at the gradient's cyan (#22D3EE) end,
   where white-on-background contrast alone dips below WCAG AA (~2.7:1). */
.btn-primary{background:var(--grad);color:#fff;text-shadow:0 1px 2px rgba(15,10,40,.35);padding:13px 24px;font-size:15px;box-shadow:0 10px 26px -10px rgba(109,77,251,.75);}
.btn-primary:hover{transform:translateY(-2px);filter:brightness(1.05);}
.btn-sm{padding:10px 18px;font-size:14px;}
.btn-ghost{background:#fff;color:var(--ink);border:1px solid var(--line);padding:13px 24px;border-radius:999px;font-weight:600;font-size:15px;}

/* ── Z-index layering ──────────────────────────────────── */
main,footer.site{position:relative;z-index:1;}

/* ── Sections ──────────────────────────────────────────── */
section.block{padding:88px 0;}
/* Sticky header is 74px tall; offset anchor scrolling so its heading
   doesn't land underneath it (74px + 20px breathing room). */
section.block[id]{scroll-margin-top:94px;}
.head{margin-bottom:36px;}
.head.center{text-align:center;max-width:640px;margin:0 auto 40px;}
.head h2{font-weight:700;font-size:clamp(1.8rem,3.1vw,2.5rem);letter-spacing:-.02em;line-height:1.12;}
.head p{color:var(--ink-2);font-size:1.05rem;margin-top:10px;}

/* ── Shared pills ──────────────────────────────────────── */
.fresh{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--fresh);background:var(--fresh-bg);padding:5px 11px;border-radius:999px;}
.fresh .d{width:6px;height:6px;border-radius:50%;background:var(--fresh);}
.pill{align-self:flex-start;font-size:12px;font-weight:600;padding:4px 11px;border-radius:999px;background:var(--soft);color:var(--accent);}
.pill.s{background:var(--bg-2);color:var(--ink-3);}

/* ── Category grid ─────────────────────────────────────── */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:22px;}

/* ── Scrollable tables ─────────────────────────────────────
   Shared, site-wide fix for tables on narrow screens: wrap any table in
   <div class="table-scroll"> and it scrolls sideways instead of squashing
   its columns into unreadable slivers. Used by the homepage showcase
   mockup, the listicle comparison table, and (via markdoc.config.mjs)
   any table an author adds to a listicle's body content — so every
   current and future table on the site inherits this automatically. */
.table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
.table-scroll table{min-width:480px;}

/* ── Responsive ────────────────────────────────────────── */
@media(max-width:820px){
  .sc-grid{grid-template-columns:1fr!important;gap:30px!important;}
  .bgrid{grid-template-columns:1fr!important;}
  .farrow{display:none;}
}
</style>
