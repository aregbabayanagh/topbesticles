---
import Base from '../layouts/Base.astro';

const homeUrl = new URL('/', Astro.site).href;
const aboutUrl = new URL('/about/', Astro.site).href;

const metaDescription =
  "TopBesticles publishes independent best-of rankings across every category. Founded by Areg Babayan. Here's who's behind the lists and why we started.";

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'About', item: aboutUrl },
  ],
};

const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About TopBesticles',
  description: metaDescription,
  url: aboutUrl,
  about: { '@type': 'Organization', name: 'TopBesticles' },
};
---

<Base
  title="About TopBesticles"
  description={metaDescription}
  metaTitle="About TopBesticles — Who We Are and How We Rank"
  metaDescription={metaDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageLd)} />

  <section class="block about">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">About</span>
      </nav>

      <div class="head center">
        <h1>About TopBesticles</h1>
      </div>

      <div class="about-sections">
        <div class="about-card">
          <h2>Why this site exists</h2>
          <p>Search for the best anything and you'll get a list. What you usually won't get is a straight answer.</p>
          <p>
            Most "best of" lists are written by someone with a stake in the outcome. When we researched SEO
            agencies, we found that nearly every ranking was published by an agency — and most of them put
            themselves at number one. One agency founder had to publish a review of his own company because
            competitors were publishing comparison pages about him containing deliberate inaccuracies.
          </p>
          <p>That's the problem. Not that the information is hard to find, but that it's hard to trust.</p>
          <p>
            TopBesticles exists to fix that for the person doing the searching. One place where the rankings
            are researched properly, the trade-offs are stated honestly, and the date on the page tells you
            when someone last checked.
          </p>
        </div>

        <div class="about-card">
          <h2>Who's behind it</h2>
          <p>
            TopBesticles was founded by Areg Babayan, who works in SEO and digital marketing, with a focus in
            recent years on AI search optimization — how information gets found, surfaced, and cited by AI
            assistants rather than just ranked in a search engine.
          </p>
          <p>
            That background is the reason this site is built the way it is. Every list is structured so that
            both people and AI systems can read it: clear rankings, real pricing, labelled facts, honest pros
            and cons, and a visible last-updated date. If a machine is going to answer someone's question by
            drawing on a source, that source should be accurate.
          </p>
        </div>

        <div class="diff-section">
          <h2>What we do differently</h2>
          <div class="bgrid">
            <div class="bcard">
              <span class="bg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="8" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="12" cy="12" r="0.6" fill="#fff" />
                </svg>
              </span>
              <h4>We name a clear winner</h4>
              <p>Not twenty options ranked by nothing. A specific best pick for each kind of buyer, with the reasoning shown.</p>
            </div>
            <div class="bcard">
              <span class="bg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="10" cy="10" r="6" />
                  <path d="M15 15l5 5" />
                  <path d="M7.3 10l1.8 1.8L12.5 8" />
                </svg>
              </span>
              <h4>We verify against primary sources</h4>
              <p>
                Pricing comes from the company's own site. If we can't confirm a figure, we say "Custom" rather
                than guessing. When we researched real estate CRMs, we found list after list still recommending
                LionDesk — a product that shut down in September 2025. Those lists were copied, not checked.
              </p>
            </div>
            <div class="bcard">
              <span class="bg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4v16M5 8h14M7 8l-3 6h6zM17 8l-3 6h6z" />
                </svg>
              </span>
              <h4>We publish the trade-offs</h4>
              <p>Every entry has real cons. A list where nothing has a downside isn't a list, it's an advert.</p>
            </div>
            <div class="bcard">
              <span class="bg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
              </span>
              <h4>We date everything</h4>
              <p>Every page shows when it was last reviewed, and we only change that date when we've genuinely re-checked the facts.</p>
            </div>
          </div>
          <p class="diff-more"><a href="/how-we-rank">Read the full methodology &rarr;</a></p>
        </div>

        <div class="about-card">
          <h2>For companies</h2>
          <p>
            If you build something good, we want to know about it. We're always evaluating tools, services and
            products to feature in our category lists, and being included puts you in front of buyers at the
            moment they're deciding — and increasingly, inside the AI answers they're asking.
          </p>
          <p>You can <a href="/contact">get in touch here</a>.</p>
        </div>

        <div class="about-card">
          <h2>Our commitment</h2>
          <p>
            TopBesticles is reader-supported and may earn commissions or fees from links and partnerships on
            this site. Any paid placement is labelled as such on the page.
          </p>
          <p>What doesn't change is the research. If a product is worse, we say so.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.crumbs{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-3);margin-bottom:24px;}
.crumbs a{color:var(--ink-2);}
.crumbs a:hover{color:var(--accent);}
.crumbs .sep{color:var(--ink-3);}
.crumbs [aria-current]{color:var(--ink);font-weight:600;}

.about-sections{display:flex;flex-direction:column;gap:24px;max-width:780px;margin:0 auto;}

.about-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:36px 40px;box-shadow:var(--sh);}
.about-card h2{font-weight:700;font-size:clamp(1.4rem,2.2vw,1.7rem);letter-spacing:-.02em;margin-bottom:16px;}
.about-card p{color:var(--ink-2);line-height:1.7;font-size:15.5px;margin-bottom:14px;}
.about-card p:last-child{margin-bottom:0;}
.about-card a{color:var(--accent);text-decoration:underline;text-underline-offset:2px;}

.diff-section h2{font-weight:700;font-size:clamp(1.4rem,2.2vw,1.7rem);letter-spacing:-.02em;margin-bottom:20px;}
.diff-more{text-align:center;margin-top:24px;}
.diff-more a{color:var(--accent);font-weight:600;font-size:14.5px;text-decoration:none;}
.diff-more a:hover{color:var(--accent-2);}

.bgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;}
.bcard{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px 24px;box-shadow:var(--sh);transition:transform .2s,box-shadow .2s;}
.bcard:hover{transform:translateY(-4px);box-shadow:var(--sh-h);}
.bcard .bg{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:var(--grad);box-shadow:0 8px 18px -8px rgba(109,77,251,.7);}
.bcard h4{font-weight:600;font-size:1.1rem;margin:16px 0 8px;letter-spacing:-.01em;}
.bcard p{color:var(--ink-2);font-size:14.5px;line-height:1.55;margin:0;}

@media(max-width:820px){
  .bgrid{grid-template-columns:1fr;}
  .about-card{padding:28px 24px;}
}
</style>
