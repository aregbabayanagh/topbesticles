---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import ConstellationCover from '../components/ConstellationCover.astro';
import { renderMarkdocInline, renderMarkdocParagraphs } from '../lib/inlineMarkdoc';

// Listicles are served flat at the site root: /<slug>
export async function getStaticPaths() {
  const [listicles, categories] = await Promise.all([
    getCollection('listicles', ({ data }) => !data.draft),
    getCollection('categories'),
  ]);
  // Key by entry.id (the real slug — Keystatic stores it as the filename, not
  // in the data), and keep the id alongside title for building the link.
  const catById = new Map(
    categories.map((c) => [c.id, { slug: c.id, title: c.data.title }])
  );
  return listicles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, category: catById.get(entry.data.category) ?? null },
  }));
}

const { entry, category } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Items in rank order.
const items = [...data.items].sort((a, b) => a.rank - b.rank);

// Dates.
const updatedShort = data.lastUpdated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const updatedLong = data.lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedISO = data.lastUpdated.toISOString().slice(0, 10);

// intro, keyTakeaways and faq[].answer are rich-text (markdoc.inline) fields
// in Keystatic — parsed here through the same Markdoc engine as body content
// so inline citation links render as real <a> tags, with the same
// nofollow-by-domain rule (src/lib/inlineMarkdoc.ts). Blank-line-separated
// paragraphs in intro become real <p class="lede"> tags.
const introHtml = renderMarkdocParagraphs(data.intro, 'lede');

// Absolute URLs for structured data.
const homeUrl = new URL('/', Astro.site).href;
const pageUrl = new URL(`/${entry.id}/`, Astro.site).href;
const categoryUrl = category ? new URL(`/category/${category.slug}/`, Astro.site).href : null;

// ── JSON-LD ────────────────────────────────────────────────────────────
const crumbItems = [{ '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl }];
if (category && categoryUrl) {
  crumbItems.push({ '@type': 'ListItem', position: 2, name: category.title, item: categoryUrl });
}
crumbItems.push({ '@type': 'ListItem', position: crumbItems.length + 1, name: data.title, item: pageUrl });

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbItems,
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: data.title,
  itemListElement: items.map((item) => ({
    '@type': 'ListItem',
    position: item.rank,
    name: item.name,
    url: item.url,
    description: item.description,
  })),
};

const faqLd = data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---
<Base title={data.title} description={data.dek} metaTitle={data.metaTitle} metaDescription={data.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <article class="listicle">
    <div class="reading">
      <!-- 1. Breadcrumbs -->
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">&rsaquo;</span>
        {category && (
          <>
            <a href={`/category/${category.slug}`}>{category.title}</a>
            <span class="sep" aria-hidden="true">&rsaquo;</span>
          </>
        )}
        <span aria-current="page">{data.title}</span>
      </nav>

      <!-- 2. Header -->
      <header class="lc-head">
        <h1>{data.title}</h1>
        <p class="dek">{data.dek}</p>
        <div class="meta-row">
          {category && <a class="cat-link" href={`/category/${category.slug}`}>{category.title}</a>}
          <span class="fresh"><span class="d"></span>Updated {updatedShort}</span>
          <a class="method-link" href="/how-we-rank">How we rank</a>
        </div>
        <p class="byline">Last updated <time datetime={updatedISO}>{updatedLong}</time></p>
      </header>

      <!-- 3. Hero image (falls back to generated cover art when unset, so
           the page never has a blank gap where the hero would be) -->
      {data.heroImage ? (
        <Image class="hero-img" src={data.heroImage} alt={data.heroImageAlt || data.title} width={1200} height={480} loading="eager" />
      ) : (
        <div class="hero-img hero-fallback">
          <ConstellationCover />
        </div>
      )}

      <!-- 4. Quick answer + Key takeaways (collapsible <details> so the full
           text is always in the static HTML — collapsing/expanding is a pure
           CSS/native-browser affordance, nothing JS-injected). Stacked, full
           width; Key takeaways only renders when populated. -->
      <div class="summary-grid">
        <details class="summary-card quick" open>
          <summary>
            <span class="summary-label">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>
              Quick answer
            </span>
            <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <p>{data.quickAnswer}</p>
        </details>

        {data.keyTakeaways.length > 0 && (
          <details class="summary-card takeaways" open>
            <summary>
              <span class="summary-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                Key takeaways
              </span>
              <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <ul>
              {data.keyTakeaways.map((t) => <li set:html={renderMarkdocInline(t)} />)}
            </ul>
          </details>
        )}
      </div>

      <!-- Intro lede -->
      <Fragment set:html={introHtml} />

      <!-- 5. Comparison table -->
      <section class="section">
        <h2 class="sec-title">At a glance</h2>
        <div class="cmp-wrap">
          <div class="table-scroll">
            <table class="cmp-table">
              <thead>
                <tr><th>Rank</th><th>Name</th><th>Best for</th><th>Starting price</th></tr>
              </thead>
              <tbody>
                {items.map((item) => (
                  <tr class={item.rank === 1 ? 'top' : undefined}>
                    <td class="rk">#{item.rank}</td>
                    <td class="nm">
                      {item.name}
                      {item.rank === 1 && <span class="top-badge">Top pick</span>}
                    </td>
                    <td>{item.bestFor}</td>
                    <td>{item.startingPrice}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 6. Ranked items -->
      <section class="section">
        <h2 class="sec-title">The rankings</h2>
        <div class="items">
          {items.map((item) => {
            // "First paragraph" = up to the first blank-line break; anything
            // after that (rare today, but the field supports multiline text)
            // goes behind the Read more toggle along with facts/pros/cons.
            const paragraphs = item.description.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
            const [firstParagraph, ...restParagraphs] = paragraphs.length > 0 ? paragraphs : [item.description];
            const facts = [
              { label: 'Founded', value: item.founded },
              { label: 'Headquarters', value: item.headquarters },
              { label: 'Founders', value: item.founders },
              { label: 'Notable clients', value: item.notableClients },
              { label: 'Reviews', value: item.reviewScore },
            ].filter((f) => f.value);

            const socials = [
              { key: 'linkedin', label: 'LinkedIn', url: item.linkedin },
              { key: 'twitter', label: 'Twitter / X', url: item.twitter },
              { key: 'facebook', label: 'Facebook', url: item.facebook },
              { key: 'instagram', label: 'Instagram', url: item.instagram },
              { key: 'youtube', label: 'YouTube', url: item.youtube },
              { key: 'tiktok', label: 'TikTok', url: item.tiktok },
            ].filter((s) => s.url);

            return (
              <div class={`item${item.rank === 1 ? ' featured' : ''}`} id={`rank-${item.rank}`}>
                <div class="item-head">
                  <div class="item-head-left">
                    <div class="item-badge-row">
                      <span class="rank-badge">#{item.rank}</span>
                      {item.logo && (
                        <Image class="logo" src={item.logo} alt={item.logoAlt || `${item.name} logo`} width={96} height={96} loading="lazy" />
                      )}
                    </div>
                    <div class="item-title">
                      <h2 class="item-name">{item.name}</h2>
                      <p class="starting-price">{item.startingPrice}</p>
                      <div class="item-sub">
                        <span class="pill">Best for {item.bestFor}</span>
                        {item.sponsored && <span class="sponsored-badge">Sponsored</span>}
                      </div>
                    </div>
                  </div>
                  <a
                    class="btn btn-primary btn-sm visit"
                    href={item.url}
                    target="_blank"
                    rel={[
                      item.sponsored && 'sponsored',
                      item.linkRel === 'nofollow' && 'nofollow',
                      'noopener',
                    ].filter(Boolean).join(' ')}
                  >
                    Visit {item.name}
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                  </a>
                </div>

                <p class="item-desc">{firstParagraph}</p>

                <details class="item-more">
                  <summary>
                    <span class="label-closed">Read more about {item.name}</span>
                    <span class="label-open">Show less</span>
                    <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="more-body">
                    {restParagraphs.map((p) => <p class="item-desc">{p}</p>)}

                    {facts.length > 0 && (
                      <dl class="facts">
                        {facts.map((f) => (
                          <div class="facts-row">
                            <dt>{f.label}</dt>
                            <dd>{f.value}</dd>
                          </div>
                        ))}
                      </dl>
                    )}

                    {socials.length > 0 && (
                      <div class="item-socials">
                        {socials.map((s) => (
                          <a
                            href={s.url}
                            target="_blank"
                            rel="noopener"
                            aria-label={`${item.name} on ${s.label}`}
                            class="item-social-link"
                          >
                            {s.key === 'linkedin' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                                <rect x="2" y="9" width="4" height="12" />
                                <circle cx="4" cy="4" r="2" />
                              </svg>
                            )}
                            {s.key === 'twitter' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
                              </svg>
                            )}
                            {s.key === 'facebook' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                              </svg>
                            )}
                            {s.key === 'instagram' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                              </svg>
                            )}
                            {s.key === 'youtube' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
                                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
                              </svg>
                            )}
                            {s.key === 'tiktok' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 7.917v4.034a9.948 9.948 0 0 1-5-1.951v6.5a6.5 6.5 0 1 1-8-6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917z" />
                              </svg>
                            )}
                          </a>
                        ))}
                      </div>
                    )}

                    <div class="proscons">
                      <div class="pros">
                        <h3>Pros</h3>
                        <ul>{item.pros.map((p) => <li>{p}</li>)}</ul>
                      </div>
                      <div class="cons">
                        <h3>Cons</h3>
                        <ul>{item.cons.map((c) => <li>{c}</li>)}</ul>
                      </div>
                    </div>
                  </div>
                </details>
              </div>
            );
          })}
        </div>
      </section>

      <!-- 7. Rich-text body -->
      <section class="section prose">
        <Content />
      </section>

      <!-- 8. FAQ -->
      {data.faq.length > 0 && (
        <section class="section">
          <h2 class="sec-title">Frequently asked questions</h2>
          <div class="faq">
            {data.faq.map((f) => (
              <div class="faq-item">
                <h3>{f.question}</h3>
                <p set:html={renderMarkdocInline(f.answer)} />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 9. Closing CTA -->
      <aside class="closing">
        <h2>Keep exploring</h2>
        <p>Every pick above is hand-checked and refreshed as the market moves.</p>
        <div class="cta-row">
          {category && <a class="btn btn-primary" href={`/category/${category.slug}`}>More {category.title} lists</a>}
          <a class="btn-ghost" href="/category">Browse all categories</a>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
.listicle{padding:38px 0 20px;}
.reading{max-width:840px;margin:0 auto;padding:0 24px;}

/* Breadcrumbs */
.crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;color:var(--ink-3);margin-bottom:26px;}
.crumbs a{color:var(--ink-2);}
.crumbs a:hover{color:var(--accent);}
.crumbs [aria-current]{color:var(--ink);font-weight:600;}

/* Header */
.lc-head{margin-bottom:26px;}
.lc-head h1{font-weight:700;font-size:clamp(2rem,4vw,3rem);line-height:1.08;letter-spacing:-.025em;}
.lc-head .dek{font-size:1.2rem;color:var(--ink-2);margin-top:14px;line-height:1.55;max-width:680px;}
.meta-row{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:18px;}
.cat-link{font-size:12.5px;font-weight:600;color:var(--accent);background:var(--soft);padding:5px 12px;border-radius:999px;}
.cat-link:hover{filter:brightness(.96);}
.method-link{font-size:12.5px;color:var(--ink-3);text-decoration:underline;text-underline-offset:2px;}
.method-link:hover{color:var(--accent);}
.lc-head .byline{font-size:13px;color:var(--ink-3);margin-top:14px;}

/* Hero */
.hero-img{width:100%;height:auto;aspect-ratio:12/5;object-fit:cover;border-radius:18px;box-shadow:var(--sh);margin-bottom:30px;}
.hero-fallback{overflow:hidden;}
.hero-fallback svg{width:100%;height:100%;display:block;}

/* Quick answer + Key takeaways — stacked, full-width <details> summary
   block. Native <details>/<summary> keeps the full content in the static
   HTML (crawlers always see it) while still being user-collapsible with no
   JS. */
.summary-grid{display:flex;flex-direction:column;gap:20px;margin-bottom:28px;}

.summary-card{position:relative;border:1px solid var(--line);border-radius:18px;padding:22px 26px;box-shadow:var(--sh);overflow:hidden;}
.summary-card summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:10px;user-select:none;}
.summary-card summary::-webkit-details-marker{display:none;}
.summary-card .chev{flex:none;color:var(--ink-3);transition:transform .2s;}
.summary-card[open] .chev{transform:rotate(180deg);}
.summary-card .summary-label{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);}

.summary-card.quick{background:linear-gradient(135deg,var(--soft) 0%,#E6F7FA 100%);}
.summary-card.quick::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--grad);}
.summary-card.quick p{margin-top:14px;font-size:1.05rem;line-height:1.6;color:var(--ink);font-weight:500;}

.summary-card.takeaways{background:var(--card);}
.summary-card.takeaways ul{list-style:none;display:flex;flex-direction:column;gap:10px;margin-top:14px;}
.summary-card.takeaways li{position:relative;padding-left:20px;font-size:14.5px;color:var(--ink-2);line-height:1.55;}
.summary-card.takeaways li::before{content:"";position:absolute;left:0;top:7px;width:7px;height:7px;border-radius:50%;background:var(--grad);}

/* Intro lede */
.lede{font-size:1.14rem;line-height:1.75;color:var(--ink-2);margin-bottom:20px;}
.lede:last-of-type{margin-bottom:40px;}

/* Sections */
.section{margin-bottom:44px;}
.sec-title{font-weight:700;font-size:clamp(1.4rem,2.4vw,1.7rem);letter-spacing:-.02em;margin-bottom:18px;}

/* Comparison table */
.cmp-wrap{border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--sh);background:var(--card);}
.cmp-table{width:100%;border-collapse:collapse;font-size:14.5px;}
.cmp-table thead th{background:var(--bg-2);text-align:left;padding:13px 16px;font-size:11.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-3);font-weight:700;}
.cmp-table td{padding:14px 16px;border-top:1px solid var(--line);color:var(--ink-2);vertical-align:middle;}
.cmp-table tbody tr.top{background:linear-gradient(90deg,rgba(109,77,251,.07),rgba(34,211,238,.04));}
.cmp-table .rk{font-weight:800;color:var(--accent);white-space:nowrap;}
.cmp-table .nm{font-weight:600;color:var(--ink);}
.top-badge{display:inline-block;margin-left:8px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:#fff;background:var(--grad);padding:2px 8px;border-radius:999px;vertical-align:middle;}

/* Ranked items */
.items{display:flex;flex-direction:column;gap:20px;}
.item{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:var(--sh);scroll-margin-top:90px;}
.item.featured{border:1.5px solid transparent;background:linear-gradient(var(--card),var(--card)) padding-box,var(--grad) border-box;box-shadow:var(--sh-h);}
.item-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;}
.item-head-left{display:flex;flex-direction:column;align-items:flex-start;gap:12px;flex:1 1 320px;min-width:0;}
.item-badge-row{display:flex;align-items:center;gap:10px;}
.rank-badge{flex:none;width:44px;height:44px;border-radius:12px;background:var(--soft);color:var(--accent);font-weight:800;font-size:15px;display:grid;place-items:center;}
.item.featured .rank-badge{background:var(--grad);color:#fff;box-shadow:0 8px 20px -6px rgba(109,77,251,.6);}
.logo{flex:none;width:48px;height:48px;border-radius:10px;border:1px solid var(--line);background:#fff;object-fit:contain;padding:5px;}
.item-title{display:flex;flex-direction:column;gap:7px;min-width:0;}
.item-name{font-weight:700;font-size:1.25rem;letter-spacing:-.01em;}
.starting-price{font-size:14px;color:var(--ink-2);font-weight:600;}
.item-sub{display:flex;flex-wrap:wrap;align-items:center;gap:10px;}
.sponsored-badge{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#9a6a00;background:#fff3d6;border:1px solid #f0d999;padding:3px 9px;border-radius:999px;}
.visit{flex:none;text-decoration:none;white-space:nowrap;}
.item-desc{margin-top:16px;color:var(--ink-2);line-height:1.7;font-size:15.5px;}

/* Read more toggle — native <details>, so collapsed content stays in the
   static HTML for crawlers; the browser (not JS) hides it until opened. */
.item-more{margin-top:14px;}
.item-more summary{cursor:pointer;display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:14px;color:var(--accent);list-style:none;user-select:none;}
.item-more summary::-webkit-details-marker{display:none;}
.item-more summary:hover{color:var(--accent-2);}
.item-more .chev{flex:none;transition:transform .2s;}
.item-more[open] .chev{transform:rotate(180deg);}
.item-more .label-open{display:none;}
.item-more[open] .label-closed{display:none;}
.item-more[open] .label-open{display:inline;}
