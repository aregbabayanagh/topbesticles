---
import Base from '../../layouts/Base.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { getCollection } from 'astro:content';

// Lives at /category (this file is category/index.astro), which is a
// distinct route from category/[slug].astro's /category/<slug> — Astro
// resolves them independently, so there's no collision.
const [categories, listicles] = await Promise.all([
  getCollection('categories'),
  getCollection('listicles', ({ data }) => !data.draft),
]);

const countByCategory = new Map<string, number>();
for (const l of listicles) {
  countByCategory.set(l.data.category, (countByCategory.get(l.data.category) ?? 0) + 1);
}

const sortedCategories = [...categories].sort((a, b) => a.data.title.localeCompare(b.data.title));

// BreadcrumbList JSON-LD (Home → Categories).
const homeUrl = new URL('/', Astro.site).href;
const categoriesUrl = new URL('/category/', Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: categoriesUrl },
  ],
};
---
<Base
  title="Browse all categories"
  description="Every category of hand-checked best-of shortlists on TopBesticles, in one place."
  metaTitle="Browse All Categories | TopBesticles"
  metaDescription="Browse every category of hand-checked best-of software and service shortlists on TopBesticles."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <section class="block cat">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Categories</span>
      </nav>

      <div class="cat-head">
        <h1>Browse all categories</h1>
        <p class="cat-desc">Every shortlist we publish, organized by category.</p>
      </div>

      {sortedCategories.length > 0 ? (
        <>
          <div class="searchbar">
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              id="cat-index-search"
              type="search"
              autocomplete="off"
              placeholder="Search categories…"
              aria-label="Search categories"
            />
          </div>

          <div class="grid" id="cat-index-grid">
            {sortedCategories.map((cat, i) => (
              <CategoryCard
                title={cat.data.title}
                href={`/category/${cat.id}`}
                description={cat.data.description}
                coverImage={cat.data.coverImage}
                coverImageAlt={cat.data.coverImageAlt}
                count={countByCategory.get(cat.id) ?? 0}
                coverVariant={i}
                search={`${cat.data.title} ${cat.data.heading ?? ''} ${cat.data.description}`.toLowerCase()}
              />
            ))}
          </div>

          <div class="empty" id="cat-index-no-match" hidden>
            <h3>No matches</h3>
            <p>Nothing here matches <strong id="cat-index-no-match-q"></strong>. Try a different search.</p>
          </div>
        </>
      ) : (
        <div class="empty">
          <h3>Categories coming soon</h3>
          <p>We're building out our first shortlists. Check back shortly.</p>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById('cat-index-search') as HTMLInputElement | null;
  const grid = document.getElementById('cat-index-grid');
  const noMatch = document.getElementById('cat-index-no-match');
  const noMatchQ = document.getElementById('cat-index-no-match-q');

  if (input && grid && noMatch) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-search]'));

    const applyFilter = () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const hay = card.getAttribute('data-search') ?? '';
        const show = q === '' || hay.includes(q);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      noMatch.hidden = visible !== 0;
      if (noMatchQ) noMatchQ.textContent = `“${input.value.trim()}”`;
    };

    input.addEventListener('input', applyFilter);
  }
</script>

<style>
.crumbs{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-3);margin-bottom:24px;}
.crumbs a{color:var(--ink-2);}
.crumbs a:hover{color:var(--accent);}
.crumbs .sep{color:var(--ink-3);}
.crumbs [aria-current]{color:var(--ink);font-weight:600;}

.cat-head{max-width:720px;margin-bottom:32px;}
.cat-head h1{font-weight:700;font-size:clamp(2rem,3.6vw,2.9rem);letter-spacing:-.02em;line-height:1.1;}
.cat-desc{color:var(--ink-2);font-size:1.1rem;margin-top:12px;line-height:1.6;}

.searchbar{position:relative;max-width:440px;margin-bottom:34px;}
.searchbar .ico{position:absolute;left:17px;top:50%;transform:translateY(-50%);color:var(--ink-3);pointer-events:none;}
.searchbar input{width:100%;font-family:inherit;font-size:15px;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:999px;padding:13px 20px 13px 46px;box-shadow:var(--sh);outline:none;transition:border-color .15s,box-shadow .15s;}
.searchbar input::placeholder{color:var(--ink-3);}
.searchbar input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(109,77,251,.15);}

.empty{text-align:center;padding:56px 20px 40px;color:var(--ink-2);}
.empty h3{font-weight:700;font-size:1.4rem;color:var(--ink);margin-bottom:10px;}
.empty p{max-width:440px;margin:0 auto;line-height:1.6;}
</style>
