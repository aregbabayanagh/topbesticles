---
import Base from '../layouts/Base.astro';
import DnaBackground from '../components/DnaBackground.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import Benefits from '../components/Benefits.astro';
import CitedBand from '../components/CitedBand.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Partner from '../components/Partner.astro';
import { getCollection } from 'astro:content';

// "Browse by category" reads from the categories collection. Each listicle's
// `category` field points at a category slug, so we tally counts per category.
const categories = await getCollection('categories');
const listicles = await getCollection('listicles');

const countByCategory = new Map<string, number>();
for (const l of listicles) {
  countByCategory.set(l.data.category, (countByCategory.get(l.data.category) ?? 0) + 1);
}

// The homepage grid shows at most 4 categories. If any category is marked
// `featured`, only featured categories compete for those slots; otherwise
// every category does. `order` (ascending) breaks ties within that pool —
// unset/equal `order` values fall back to alphabetical by title.
const pool = categories.some((c) => c.data.featured)
  ? categories.filter((c) => c.data.featured)
  : categories;
const featuredCategories = [...pool]
  .sort((a, b) => {
    const orderDiff = (a.data.order ?? Infinity) - (b.data.order ?? Infinity);
    return orderDiff !== 0 ? orderDiff : a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 4);

// Fill any remaining slots (up to 4 total) with "Coming soon" placeholders.
const placeholderSlots = Math.max(0, 4 - featuredCategories.length);
---

<Base title="TopBesticles — The most complete roundup of the best tools, software & services">
  <DnaBackground slot="before-header" />

  <Hero />
  <Showcase />
  <Benefits />
  <CitedBand />

  <!-- Browse by category -->
  <section class="block" id="categories">
    <div class="wrap">
      <div class="head">
        <h2>Browse by category</h2>
        <p>Short, honest shortlists for the decisions that matter.</p>
      </div>
      <div class="grid">
        {featuredCategories.map((cat, i) => (
          <CategoryCard
            title={cat.data.title}
            href={`/category/${cat.id}`}
            description={cat.data.description}
            coverImage={cat.data.coverImage}
            count={countByCategory.get(cat.id) ?? 0}
            coverVariant={i}
          />
        ))}

        <!-- Coming soon placeholders — fill remaining slots up to 4 total -->
        {placeholderSlots >= 1 && (
        <CategoryCard
          title="Best Email Marketing Platforms"
          description="In research now — testing deliverability and real pricing."
          category="Marketing"
          comingSoon
        >
          <svg slot="thumb" viewBox="0 0 400 230" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <defs><linearGradient id="cv2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3FA0F5"/><stop offset="1" stop-color="#1FB6C9"/></linearGradient></defs>
            <rect width="400" height="230" fill="url(#cv2)"/>
            <line x1="346" y1="188" x2="271" y2="195" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="271" y1="195" x2="162" y2="179" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="254" y1="85" x2="178" y2="99" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="271" y1="195" x2="344" y2="123" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="346" y1="188" x2="344" y2="123" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="178" y1="99" x2="162" y2="179" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="58" y1="50" x2="162" y2="179" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="254" y1="85" x2="344" y2="123" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="58" y1="50" x2="178" y2="99" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <circle cx="346" cy="188" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="58" cy="50" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="254" cy="85" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="178" cy="99" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="271" cy="195" r="13" fill="#fff" fill-opacity="0.25"/>
            <circle cx="271" cy="195" r="6" fill="#fff"/>
            <circle cx="344" cy="123" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="162" cy="179" r="4" fill="#fff" fill-opacity="0.85"/>
          </svg>
        </CategoryCard>
        )}

        {placeholderSlots >= 2 && (
        <CategoryCard
          title="Best Project Management Software"
          description="Candidate list being built and verified."
          category="Operations"
          comingSoon
        >
          <svg slot="thumb" viewBox="0 0 400 230" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <defs><linearGradient id="cv3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8B5CF6"/><stop offset="1" stop-color="#6366F1"/></linearGradient></defs>
            <rect width="400" height="230" fill="url(#cv3)"/>
            <line x1="359" y1="111" x2="243" y2="175" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="240" y1="46" x2="283" y2="131" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="240" y1="46" x2="243" y2="175" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="116" y1="123" x2="136" y2="41" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="116" y1="123" x2="44" y2="170" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="243" y1="175" x2="283" y2="131" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="44" y1="170" x2="136" y2="41" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="240" y1="46" x2="136" y2="41" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="359" y1="111" x2="283" y2="131" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <circle cx="116" cy="123" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="240" cy="46" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="44" cy="170" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="359" cy="111" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="243" cy="175" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="283" cy="131" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="136" cy="41" r="13" fill="#fff" fill-opacity="0.25"/>
            <circle cx="136" cy="41" r="6" fill="#fff"/>
          </svg>
        </CategoryCard>
        )}

        {placeholderSlots >= 3 && (
        <CategoryCard
          title="Best AI Writing Tools"
          description="Putting the top contenders through real tasks."
          category="AI tools"
          comingSoon
        >
          <svg slot="thumb" viewBox="0 0 400 230" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <defs><linearGradient id="cv4" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0EA5E9"/><stop offset="1" stop-color="#14B8A6"/></linearGradient></defs>
            <rect width="400" height="230" fill="url(#cv4)"/>
            <line x1="116" y1="53" x2="61" y2="100" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="334" y1="164" x2="212" y2="80" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="285" y1="72" x2="212" y2="80" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="61" y1="100" x2="109" y2="184" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="212" y1="80" x2="139" y2="136" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="116" y1="53" x2="139" y2="136" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="334" y1="164" x2="285" y2="72" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="109" y1="184" x2="139" y2="136" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <line x1="61" y1="100" x2="139" y2="136" stroke="#fff" stroke-opacity="0.45" stroke-width="1.5"/>
            <circle cx="116" cy="53" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="61" cy="100" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="334" cy="164" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="285" cy="72" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="212" cy="80" r="4" fill="#fff" fill-opacity="0.85"/>
            <circle cx="109" cy="184" r="13" fill="#fff" fill-opacity="0.25"/>
            <circle cx="109" cy="184" r="6" fill="#fff"/>
            <circle cx="139" cy="136" r="4" fill="#fff" fill-opacity="0.85"/>
          </svg>
        </CategoryCard>
        )}
      </div>

      <div class="view-all">
        <a class="btn-ghost" href="/category">View all categories</a>
      </div>
    </div>
  </section>

  <Partner />
</Base>

<style>
.view-all{text-align:center;margin-top:36px;}
</style>
