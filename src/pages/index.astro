---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const listicles = await getCollection('listicles');
---
<Base title="Home">
  <h1 style="font-size:2rem;font-weight:800;margin-bottom:0.5rem;">TopBesticles</h1>
  <p style="color:#6b7280;margin-bottom:2rem;">Curated best-of lists structured for AI search.</p>

  <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:1rem;">Latest Listicles</h2>
  <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;">
    {listicles.map((l) => (
      <li style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.25rem 1.5rem;">
        <a href={`/listicles/${l.id}`} style="text-decoration:none;color:inherit;">
          <div style="font-size:0.75rem;color:#6b7280;margin-bottom:0.25rem;">{l.data.category}</div>
          <div style="font-weight:700;font-size:1.1rem;margin-bottom:0.25rem;">{l.data.title}</div>
          <div style="font-size:0.9rem;color:#374151;">{l.data.dek}</div>
        </a>
      </li>
    ))}
  </ul>
</Base>
