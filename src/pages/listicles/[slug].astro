---
import { getCollection } from 'astro:content';

// Permanent redirect: the old /listicles/<slug> URLs now live flat at /<slug>.
// Static-safe redirect (meta refresh + rel=canonical) so old links / bookmarks
// and any external inbound links keep working. These pages are excluded from
// the sitemap (see astro.config.mjs `filter`) so only the new URLs are indexed.
export async function getStaticPaths() {
  const listicles = await getCollection('listicles');
  return listicles.map((entry) => ({
    params: { slug: entry.id },
    props: { to: `/${entry.id}` },
  }));
}

const { to } = Astro.props;
const canonical = new URL(to, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>This page has moved to <a href={to}>{to}</a>.</p>
  </body>
</html>
