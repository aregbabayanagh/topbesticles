---
import { Image } from 'astro:assets';
import ConstellationCover from './ConstellationCover.astro';

interface Props {
  title: string;
  description: string;
  href?: string;
  slug?: string;
  // Listicle-card fields (used on /category/<slug> pages)
  category?: string;
  lastUpdated?: Date;
  heroImage?: string;
  // Category-card fields (used on the homepage "Browse by category" grid)
  coverImage?: string;
  count?: number;
  coverVariant?: number;
  comingSoon?: boolean;
  // Lowercased haystack (title + dek + tags) for client-side filtering.
  search?: string;
}

const {
  title,
  description,
  href,
  slug,
  category,
  lastUpdated,
  heroImage,
  coverImage,
  count,
  coverVariant = 0,
  comingSoon = false,
  search,
} = Astro.props;

// Presence of `count` marks a category card; otherwise it's a listicle card.
const isCategory = count !== undefined;
const link = href ?? (comingSoon ? undefined : `/${slug}`);

const updatedLabel = lastUpdated
  ? lastUpdated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : null;

const countLabel = isCategory ? `${count} ${count === 1 ? 'list' : 'lists'}` : null;
---

{comingSoon ? (
  <div class="ccard soon">
    <div class="thumb">
      <slot name="thumb">
        <div class="thumb-default"></div>
      </slot>
    </div>
    <div class="cb">
      <span class="pill s">{category}</span>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="cf"><span class="pill s">Coming soon</span></div>
    </div>
  </div>
) : (
  <a class="ccard" href={link} data-search={search}>
    <div class="thumb">
      {coverImage ? (
        <Image src={coverImage} alt={title} width={400} height={230} loading="lazy" />
      ) : heroImage ? (
        <img src={heroImage} alt={title} width="400" height="230" loading="lazy" />
      ) : isCategory ? (
        <ConstellationCover variant={coverVariant} />
      ) : (
        <slot name="thumb">
          <div class="thumb-default"></div>
        </slot>
      )}
    </div>
    <div class="cb">
      <span class="pill">{isCategory ? countLabel : category}</span>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="cf">
        {!isCategory && updatedLabel && (
          <span class="fresh"><span class="d"></span>Updated {updatedLabel}</span>
        )}
        <span class="go">&rarr;</span>
      </div>
    </div>
  </a>
)}

<style is:global>
.ccard{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--sh);display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s;}
a.ccard:hover{transform:translateY(-5px);box-shadow:var(--sh-h);}
.ccard .thumb{aspect-ratio:16/9;overflow:hidden;}
.ccard .thumb svg,.ccard .thumb img{width:100%;height:100%;display:block;transition:transform .4s;object-fit:cover;}
a.ccard:hover .thumb svg,a.ccard:hover .thumb img{transform:scale(1.05);}
.ccard .thumb .thumb-default{width:100%;height:100%;background:linear-gradient(135deg,var(--v1),var(--cyan));}
.ccard .cb{padding:20px 20px 18px;display:flex;flex-direction:column;gap:10px;flex:1;}
.cf{margin-top:auto;padding-top:12px;display:flex;align-items:center;justify-content:space-between;}
.go{color:var(--accent);font-size:18px;}
.ccard h3{font-weight:600;font-size:1.18rem;letter-spacing:-.01em;}
.ccard p{color:var(--ink-2);font-size:14px;line-height:1.5;}
.ccard.soon{opacity:.74;}
.ccard.soon .thumb{filter:saturate(.7);}
</style>
