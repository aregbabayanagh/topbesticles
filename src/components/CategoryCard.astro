---
interface Props {
  title: string;
  slug?: string;
  description: string;
  lastUpdated?: Date;
  heroImage?: string;
  comingSoon?: boolean;
}

const {
  title,
  slug,
  description,
  lastUpdated,
  heroImage,
  comingSoon = false,
} = Astro.props;

const href = comingSoon ? undefined : `/listicles/${slug}`;

const updatedLabel = lastUpdated
  ? lastUpdated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : null;
---

{comingSoon ? (
  <div class="card card--soon" aria-label={`${title} — coming soon`}>
    <div class="card-img card-img--placeholder" aria-hidden="true"></div>
    <div class="card-body">
      <span class="soon-badge">Coming soon</span>
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
    </div>
  </div>
) : (
  <a class="card" href={href}>
    <div class="card-img" aria-hidden="true">
      {heroImage ? (
        <img
          src={heroImage}
          alt=""
          loading="lazy"
          decoding="async"
          width="600"
          height="338"
        />
      ) : (
        <div class="card-img--placeholder"></div>
      )}
    </div>
    <div class="card-body">
      {updatedLabel && (
        <span class="updated-pill">Updated {updatedLabel}</span>
      )}
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
      <span class="card-cta" aria-hidden="true">See the list →</span>
    </div>
  </a>
)}

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--ease), box-shadow var(--ease);
    color: var(--text);
    text-decoration: none;
  }
  a.card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  a.card:hover .card-cta {
    color: var(--accent-hover);
  }

  /* Image area */
  .card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    flex-shrink: 0;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }
  a.card:hover .card-img img { transform: scale(1.02); }

  .card-img--placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #F5F0EA 0%, #EDE7DE 100%);
  }

  /* Body */
  .card-body {
    padding: 1.2rem 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: .4rem;
    flex: 1;
  }

  .updated-pill {
    display: inline-block;
    align-self: flex-start;
    font-size: .72rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-light);
    padding: .2rem .6rem;
    border-radius: 99px;
    line-height: 1.5;
  }

  .soon-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: .72rem;
    font-weight: 500;
    color: var(--text-3);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: .2rem .6rem;
    border-radius: 99px;
    line-height: 1.5;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }

  .card-desc {
    font-size: .875rem;
    color: var(--text-2);
    line-height: 1.55;
    /* Clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta {
    margin-top: .3rem;
    font-size: .82rem;
    font-weight: 600;
    color: var(--accent);
    transition: color var(--ease);
  }

  /* Coming-soon card — muted */
  .card--soon {
    opacity: .55;
    pointer-events: none;
  }
</style>
