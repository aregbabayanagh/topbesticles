<style>
.partner{background:linear-gradient(135deg,var(--soft),#fff);border:1px solid var(--line);border-radius:24px;padding:54px 44px;text-align:center;}
.partner h2{font-weight:700;font-size:clamp(1.7rem,2.8vw,2.2rem);letter-spacing:-.02em;}
.partner p{color:var(--ink-2);max-width:480px;margin:14px auto 0;}
.partner .btn{margin-top:24px;}
