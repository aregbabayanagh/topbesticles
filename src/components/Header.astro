---
import { Image } from 'astro:assets';
import logo from '../assets/logo/top-besticles-logo.png';
import { getSettings } from '../lib/settings';

const settings = await getSettings();
const siteName = settings.siteName;
// Wordmark styling highlights the first 3 characters (matching the current
// "Top" + "Besticles" split) — keeps the existing look while the name itself
// comes from Settings.
const wordmarkAccent = siteName.slice(0, 3);
const wordmarkRest = siteName.slice(3);
---

<header class="site">
  <div class="wrap">
    <a class="logo" href="/">
      <Image src={logo} alt="TopBesticles" width={72} height={72} densities={[1, 2]} />
      <span class="wordmark"><span class="t">{wordmarkAccent}</span>{wordmarkRest}</span>
    </a>
    <nav class="main">
      <a class="hide" href="/category">Categories</a>
      <a class="hide" href="/cited-in-ai">Cited in AI</a>
      <a class="hide" href="/#why">Why us</a>
      <a class="hide" href="/about">About</a>
      <a class="btn btn-primary btn-sm" href="/contact">Get in touch</a>
    </nav>
  </div>
</header>

<style>
header.site{position:sticky;top:0;z-index:50;backdrop-filter:blur(10px);background:rgba(246,247,251,.82);border-bottom:1px solid var(--line);}
header.site .wrap{height:74px;display:flex;align-items:center;justify-content:space-between;}
.logo{display:flex;align-items:center;gap:9px;font-weight:700;font-size:21px;letter-spacing:-.02em;}
.logo img{display:block;width:36px;height:36px;}
.logo .t{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
nav.main{display:flex;gap:28px;align-items:center;}
nav.main a{color:var(--ink-2);font-weight:500;font-size:15px;}
nav.main a:hover{color:var(--ink);}
/* .btn-primary's own `color:#fff` loses to `nav.main a` above on specificity
   alone — pin it back to white here (and on hover) so it isn't inherited. */
nav.main a.btn-primary,
nav.main a.btn-primary:hover{color:#fff;}
@media(max-width:820px){nav.main .hide{display:none;}}
</style>
