<style>
.hero{position:relative;text-align:center;overflow:hidden;padding:78px 0 0;}
.hero .mesh{position:absolute;inset:0;z-index:0;pointer-events:none;}
.hero .mesh::before{content:"";position:absolute;left:46%;top:-90px;transform:translateX(-50%);width:680px;height:460px;background:radial-gradient(ellipse,rgba(109,77,251,.20),transparent 60%);filter:blur(6px);}
.hero .mesh::after{content:"";position:absolute;right:8%;top:120px;width:380px;height:380px;background:radial-gradient(circle,rgba(34,211,238,.16),transparent 65%);}
.inner{position:relative;z-index:3;}
.hero h1{font-weight:700;font-size:clamp(2.3rem,4.7vw,3.7rem);line-height:1.06;letter-spacing:-.03em;max-width:900px;margin:0 auto;}
.hero h1 .hl{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
.hero p.lead{font-size:1.18rem;color:var(--ink-2);max-width:560px;margin:20px auto 0;}
.cta{display:flex;gap:16px;justify-content:center;margin-top:30px;flex-wrap:wrap;}
.stage{position:relative;height:520px;margin-top:24px;}
.stage::before{content:"";position:absolute;left:50%;top:24px;transform:translateX(-50%);width:700px;height:430px;background:radial-gradient(ellipse at center,rgba(109,77,251,.16),transparent 60%);z-index:0;}
.lanes{position:absolute;inset:0;transform:perspective(1100px) rotateX(11deg);transform-origin:center top;z-index:2;-webkit-mask:radial-gradient(120% 90% at 50% 8%,#000 60%,transparent 100%);mask:radial-gradient(120% 90% at 50% 8%,#000 60%,transparent 100%);}
.lane{position:absolute;left:0;display:flex;gap:20px;width:max-content;animation:scrollx linear infinite;}
.lane.l1{top:40px;}.lane.l2{top:188px;animation-direction:reverse;}.lane.l3{top:336px;}
@keyframes scrollx{to{transform:translateX(-50%);}}
.pc{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:15px;padding:13px 18px;box-shadow:var(--sh);min-width:248px;}
.pc .mn{flex:none;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;}
.pc .pi{display:flex;flex-direction:column;line-height:1.25;}
.pc .pn{font-weight:600;font-size:15px;white-space:nowrap;}
.pc .pp{font-size:11.5px;color:var(--accent);font-weight:600;display:flex;align-items:center;gap:4px;}
.pc .pp b{color:#fff;background:var(--accent);border-radius:999px;width:14px;height:14px;display:grid;place-items:center;font-size:9px;}
.pc.sk{opacity:.5;}.pc.sk .mn{background:#dfe2ee;}
.pc.sk .b1{display:block;width:90px;height:9px;border-radius:5px;background:#dfe2ee;margin-bottom:7px;}
.pc.sk .b2{display:block;width:60px;height:9px;border-radius:5px;background:#e9ebf4;}
.fade{position:absolute;inset:0;z-index:3;pointer-events:none;background:radial-gradient(circle at 50% 19%,var(--bg) 0%,var(--bg) 9%,transparent 26%);}
.beam{position:absolute;left:50%;top:118px;transform:translateX(-50%);width:120px;height:360px;background:linear-gradient(to bottom,rgba(109,77,251,.5),rgba(34,211,238,.14) 42%,transparent 80%);filter:blur(10px);z-index:1;border-radius:50%;}
