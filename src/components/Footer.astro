<footer class="site">
  <div class="wrap">
    <div class="top">
      <div>
        <a class="logo" href="/"><span class="t">Top</span>Besticles</a>
        <p class="tag">The best tools in every category &mdash; checked, dated, and built to be cited.</p>
      </div>
      <div class="cols">
        <div class="col">
          <h5>Explore</h5>
          <a href="/category">Categories</a>
          <a href="/#why">Why us</a>
          <a href="/#cited">Cited in AI</a>
        </div>
        <div class="col">
          <h5>About</h5>
          <a href="/#partner">Partner with us</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </div>
    <div class="base">
      <p>TopBesticles is reader-supported and may earn commissions or fees from links and partnerships on this site.</p>
      <span>&copy; 2026 TopBesticles</span>
