---
import { Image } from 'astro:assets';
import logo from '../assets/logo/top-besticles-logo.png';
import { getSettings } from '../lib/settings';

const settings = await getSettings();
const siteName = settings.siteName;
// Wordmark styling highlights the first 3 characters (matching the current
// "Top" + "Besticles" split) — keeps the existing look while the name itself
// comes from Settings.
const wordmarkAccent = siteName.slice(0, 3);
const wordmarkRest = siteName.slice(3);
---

<footer class="site">
  <div class="wrap">
    <div class="top">
      <div>
        <a class="logo" href="/">
          <Image src={logo} alt="TopBesticles" width={64} height={64} densities={[1, 2]} />
          <span class="wordmark"><span class="t">{wordmarkAccent}</span>{wordmarkRest}</span>
        </a>
        <p class="tag">{settings.tagline}</p>
        {settings.social?.instagram && (
          <div class="social">
            <a
              href={settings.social.instagram}
              target="_blank"
              rel="noopener"
              aria-label="TopBesticles on Instagram"
              class="social-link"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          </div>
        )}
      </div>
      <div class="cols">
        <div class="col">
          <h5>Explore</h5>
          <a href="/category">Categories</a>
          <a href="/#why">Why us</a>
          <a href="/cited-in-ai">Cited in AI</a>
        </div>
        <div class="col">
          <h5>About</h5>
          <a href="/about">About us</a>
          <a href="/how-we-rank">How we rank</a>
          <a href="/#partner">Partner with us</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </div>
    <div class="base">
      <p>{settings.footerDisclosure}</p>
      <span>&copy; 2026 {siteName}</span>
    </div>
  </div>
</footer>

<style>
footer.site{background:var(--bg-2);margin-top:30px;padding:54px 0 40px;border-top:1px solid var(--line);}
.top{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;}
.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:19px;letter-spacing:-.02em;}
.logo img{display:block;width:32px;height:32px;}
.logo .t{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
.tag{color:var(--ink-2);font-size:14px;margin-top:8px;max-width:300px;}
.social{display:flex;gap:10px;margin-top:16px;}
.social-link{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:999px;background:#fff;border:1px solid var(--line);box-shadow:var(--sh);color:var(--ink-2);transition:color .15s,border-color .15s,transform .15s;}
.social-link:hover{color:var(--accent);border-color:var(--accent);transform:translateY(-2px);}
.cols{display:flex;gap:50px;flex-wrap:wrap;}
.col h5{font-size:13px;font-weight:600;color:var(--ink-3);margin-bottom:12px;}
.col a{display:block;color:var(--ink-2);font-size:14.5px;margin-bottom:9px;}
.base{margin-top:38px;padding-top:22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-3);}
.base p{max-width:620px;}
</style>
