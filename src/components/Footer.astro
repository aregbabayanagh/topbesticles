<style>
footer.site{background:var(--bg-2);margin-top:30px;padding:54px 0 40px;border-top:1px solid var(--line);}
.top{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;}
.logo{font-weight:700;font-size:19px;letter-spacing:-.02em;}
.logo .t{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
.tag{color:var(--ink-2);font-size:14px;margin-top:8px;max-width:300px;}
.cols{display:flex;gap:50px;flex-wrap:wrap;}
.col h5{font-size:13px;font-weight:600;color:var(--ink-3);margin-bottom:12px;}
.col a{display:block;color:var(--ink-2);font-size:14.5px;margin-bottom:9px;}
.base{margin-top:38px;padding-top:22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-3);}
.base p{max-width:620px;}
</style>
