<section class="block" id="cited">
  <div class="wrap">
    <div class="cited">
      <div class="ch">
        <h2>From our lists into AI answers</h2>
        <p>Earn a place on a list, and you show up where buyers increasingly search.</p>
      </div>
      <div class="flow3">
        <div class="fstep">
          <div class="fi">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
          </div>
          <h5>Researched &amp; verified</h5>
          <p>We test, fact-check, and rank the real options.</p>
        </div>
        <div class="farrow">&rarr;</div>
        <div class="fstep">
          <div class="fi">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
          </div>
          <h5>Published &amp; structured</h5>
          <p>Clean, dated lists with machine-readable markup.</p>
        </div>
        <div class="farrow">&rarr;</div>
        <div class="fstep">
          <div class="fi">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="8" x2="14" y2="12"/><line x1="7" y1="16" x2="14" y2="12"/><line x1="14" y1="12" x2="18" y2="6"/><circle cx="18" cy="6" r="1.6" fill="#fff"/></svg>
          </div>
          <h5>Cited in AI answers</h5>
          <p>Assistants surface and reference our picks.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.cited{background:linear-gradient(135deg,#15122E 0%,#2A1D63 55%,#10204F 100%);border-radius:26px;padding:64px 48px;position:relative;overflow:hidden;}
.cited::before{content:"";position:absolute;left:-60px;top:-60px;width:320px;height:320px;background:radial-gradient(circle,rgba(124,92,252,.5),transparent 65%);}
.cited::after{content:"";position:absolute;right:-40px;bottom:-80px;width:340px;height:340px;background:radial-gradient(circle,rgba(34,211,238,.35),transparent 65%);}
.ch{position:relative;z-index:2;text-align:center;max-width:600px;margin:0 auto 40px;}
.ch h2{color:#fff;font-weight:700;font-size:clamp(1.8rem,3vw,2.4rem);letter-spacing:-.02em;}
.ch p{color:#C7C9E6;margin-top:12px;}
.flow3{position:relative;z-index:2;display:flex;align-items:stretch;justify-content:center;gap:0;flex-wrap:wrap;}
.fstep{flex:1;min-width:200px;max-width:300px;text-align:center;padding:0 18px;}
.fstep .fi{width:54px;height:54px;border-radius:15px;margin:0 auto 14px;display:grid;place-items:center;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);color:#fff;backdrop-filter:blur(4px);}
.fstep h5{color:#fff;font-weight:600;font-size:1.05rem;margin-bottom:6px;}
.fstep p{color:#AEB1D6;font-size:14px;margin:0;}
.farrow{display:flex;align-items:center;color:rgba(255,255,255,.4);font-size:22px;}
@media(max-width:820px){.farrow{display:none;}}
</style>
